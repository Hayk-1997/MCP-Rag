# Directory that holds the PDFs you want to search (recursive).
PDF_DIR=./pdfs

# Where the generated search index is written.
INDEX_PATH=./data/index.json

# --- Embeddings -------------------------------------------------------------
# auto        -> OpenAI-compatible embeddings when a key or explicit EMBEDDING_BASE_URL
#                is configured, otherwise the offline hashing embedder.
# local       -> always offline hashing embedder (no network, no API key).
# openai      -> OpenAI-compatible embeddings; a keyless custom endpoint is allowed.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# Keyless local example (after `ollama pull nomic-embed-text`):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=nomic-embed-text

# --- Answer model (free/local or hosted) ------------------------------------
# LLM_ENABLED=auto | true | false
#   auto -> enabled when a chat key is set or CHAT_BASE_URL/OPENAI_BASE_URL points
#           somewhere other than api.openai.com; false otherwise.
# An API key is optional for local servers. Test with `npm run llm:check`.
LLM_ENABLED=auto
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=gpt-4o-mini
# CHAT_TEMPERATURE=0.1
# CHAT_MAX_TOKENS=800

# Free, local Ollama (run: ollama pull llama3.2):
# CHAT_BASE_URL=http://127.0.0.1:11434/v1
# CHAT_MODEL=llama3.2

# Free, local LM Studio (start its OpenAI-compatible server on port 1234):
# CHAT_BASE_URL=http://127.0.0.1:1234/v1
# CHAT_MODEL=local-model

# Groq free tier (needs a free API key):
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_API_KEY=gsk_...
# CHAT_MODEL=llama-3.3-70b-versatile

# OpenRouter free models (needs a free API key; check current :free model ids):
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_API_KEY=sk-or-...
# CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Legacy OpenAI shorthand (used for both chat and embeddings unless overridden):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Retrieval tuning -------------------------------------------------------
TOP_K=6
# Weight of vector similarity vs BM25 keyword score (0..1).
HYBRID_ALPHA=0.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Transports -------------------------------------------------------------
# stdio (default, for Claude Desktop / Cursor / any MCP client) or http
MCP_TRANSPORT=stdio
HOST=127.0.0.1
PORT=8787
